          <datasource-dependencies datasource='federated.163f8ok12utkfh1ffunin1qxeuj2'>
            <column caption='Days_by_Conditions' datatype='integer' name='[Calculation_2237163179202908160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [conditions], [city] : COUNT(DATE([recorded_at]))}' />
            </column>
            <column caption='Conditions_Percenatge' datatype='real' name='[Calculation_2237163179204866049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2237163179202908160]) / SUM({FIXED [city] : COUNT(DATE([recorded_at]))}) * 100' />
