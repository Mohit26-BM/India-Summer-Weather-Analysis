      <column caption='Is_Rainy_Day' datatype='integer' name='[Calculation_1559371434750205975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([conditions], &quot;Rain&quot;) THEN 1 ELSE 0 END' />
