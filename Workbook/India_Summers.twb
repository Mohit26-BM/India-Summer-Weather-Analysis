      <column caption='Rainy_Day_Percentage' datatype='real' name='[Calculation_1559371434751778845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1559371434751062042] / [Calculation_1559371434728214538]) * 100' />
