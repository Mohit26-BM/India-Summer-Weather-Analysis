      <aliases enabled='yes' />
      <column caption='Total Days City' datatype='integer' name='[Calculation_1559371434727178248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [city] : COUNTD(DATE([recorded_at]))}' />
      </column>
      <column caption='Total Days Numeric' datatype='integer' name='[Calculation_1559371434728214538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1559371434727178248])' />
      </column>
      <column caption='Total Days Label' datatype='string' name='[Calculation_1559371434728386571]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1559371434733834253] = 1 &#13;&#10;THEN &quot;City: &quot; + ATTR([city]) + &quot; | Total Days: &quot; + STR([Calculation_1559371434728214538])&#13;&#10;ELSE &quot;Total Days (All Cities): &quot; + STR([Calculation_1559371434728214538])&#13;&#10;END' />
      </column>
      <column caption='City Count' datatype='integer' name='[Calculation_1559371434733834253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([city])' />
      </column>
      <column caption='Average Temperature' datatype='real' name='[Calculation_1559371434736005134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([temp])' />
      </column>
      <column caption='Average Temperature Label' datatype='string' name='[Calculation_1559371434738348048]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1559371434733834253] = 1 &#13;&#10;THEN &quot;City: &quot; + ATTR([city]) + &quot; | Average Temperature: &quot; + STR(ROUND([Calculation_1559371434736005134], 1)) + &quot;°C&quot;&#13;&#10;ELSE &quot;Average Temperature (All Cities): &quot; + STR(ROUND([Calculation_1559371434736005134], 1)) + &quot;°C&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Feels-Like Temperature' datatype='real' name='[Calculation_1559371434740850705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([feelslike])' />
      </column>
      <column caption='Average Feels-Like Temperature Label' datatype='string' name='[Calculation_1559371434741121042]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1559371434733834253] = 1 &#13;&#10;THEN &quot;City: &quot; + ATTR([city]) + &quot; | Average Feels-Like Temperature: &quot; + STR(ROUND([Calculation_1559371434740850705], 1)) + &quot;°C&quot;&#13;&#10;ELSE &quot;Average Feels-Like Temperature (All Cities): &quot; + STR(ROUND([Calculation_1559371434740850705], 1)) + &quot;°C&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Humidity' datatype='real' name='[Calculation_1559371434742190099]' role='measure' type='quantitative'>
